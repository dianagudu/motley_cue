[Unit]
Description=motley_cue with gunicorn service
Before=nginx.service

[Service]
## Why root: with the local_unix backend, feudalAdapter invokes shadow-utils
## (useradd/usermod/userdel/chage) directly and writes authorized_keys into other
## users' home directories with chown(2). None of that works unprivileged, and
## nothing here goes through sudo. If you use the ldap, bonsai_ldap or bwidm
## backend, no local privileged operation happens at all -- see
## motley-cue-unprivileged.service.example for a drop-in that runs as its own
## user. This is an internet-facing API, so prefer that whenever you can.
User=root
Group=root
RuntimeDirectory=motley_cue
WorkingDirectory=/usr/lib/motley-cue
EnvironmentFile=/etc/motley_cue/motley_cue.env
ExecStart=/usr/lib/motley-cue/bin/gunicorn motley_cue.api:api -k "uvicorn.workers.UvicornWorker" --config /usr/lib/motley-cue/etc/gunicorn/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID

## Confinement. Since the service runs as root, these are what stands between a
## bug in the public API and a fully compromised host.
## On systemd < 242 (RHEL/Rocky 8) a few of these are unknown and get logged as
## "Unknown lvalue" and ignored -- the unit still starts, just less confined.
NoNewPrivileges=yes
## A private /tmp also removes any chance of a local user pre-creating the OTP
## keyfile or token database, whatever [mapper.otp] is pointed at.
PrivateTmp=yes
PrivateDevices=yes
## 'full' rather than 'strict': /usr and /boot become read-only, but /etc stays
## writable, which shadow-utils requires (it takes lock files in /etc, and
## rewrites passwd/shadow/group in place). 'strict' would need an explicit
## ReadWritePaths covering /etc, /home, /var/log, /var/lib and the mail spool,
## which is easy to get subtly wrong -- test it on a scratch host before
## switching.
ProtectSystem=full
## Must stay off: home directories are created and populated here.
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
## Only what account provisioning actually needs: chown/mode changes on new home
## directories, dropping privileges, and pkill on undeploy. Everything else --
## loading modules, changing time, raw sockets, ptrace -- is dropped.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_KILL CAP_AUDIT_WRITE

[Install]
WantedBy=multi-user.target
